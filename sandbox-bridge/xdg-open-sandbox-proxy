#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# xdg-open —— pressure-vessel 沙箱内的 URL 代理（源文件）
#
# 【为什么需要】
#   战网等 Wine 程序跑在 umu/Proton 的 pressure-vessel 沙箱内。沙箱里的
#   /usr/bin/xdg-open 是指向 steam-runtime-urlopen 的符号链接，它只会尝试：
#       1) Steam 管道     → 本环境 Steam 未运行，失败
#       2) D-Bus portal   → 沙箱内没有可用会话总线，失败
#   最终打印：
#       steam-runtime-urlopen: Unable to open URL
#   我们注册的 browser-picker 根本收不到请求 —— 这是"战网打不开浏览器"的真因。
#   而沙箱内既无 zenity、也加载不了容器库，无法就地弹窗。
#
# 【做法】
#   把 http(s) URL 写进容器与沙箱共享的 FIFO；由沙箱外的
#   url-bridge-daemon.sh 读取后调用 browser-picker 弹选择器、启动浏览器。
#
# 【安装位置】
#   由 url-bridge-start.sh 复制到 Proton 的 bin 目录 —— 该目录是 Wine 进程
#   PATH 的第一项，且位于持久挂载 steamapps 上，容器重启后仍在。
# ═══════════════════════════════════════════════════════════════════════════

FIFO="${URL_BRIDGE_FIFO:-/home/retro/.local/share/url-bridge/requests.fifo}"

case "${1:-}" in
  http://*|https://*)
    # 以 O_RDWR 打开 FIFO 不会阻塞：即使守护进程没在跑，也不会挂住调用方
    if [ -p "$FIFO" ] && exec 3<>"$FIFO" 2>/dev/null; then
      printf '%s\n' "$1" >&3 2>/dev/null
      exec 3>&- 2>/dev/null
      exit 0
    fi
    ;;
esac

# 其他协议：尽力回退到容器真实 xdg-open（沙箱内通常因缺库失败，仅 best-effort）
if [ -x /run/host/bin/sh ] && [ -x /run/host/usr/bin/xdg-open ]; then
  exec /run/host/bin/sh /run/host/usr/bin/xdg-open "$@" 2>/dev/null
fi
exit 1
